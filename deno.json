{
  "name": "@erik-castro/ollamatask",
  "version": "1.0.0",
  "license": "MIT",
  "exports": {
    ".": "./src/mod.ts",
    "./tools/FileRead": "./src/tools/FileRead.ts",
    "./tools/FileWrite": "./src/tools/FileWrite.ts",
    "./tools/FileEdit": "./src/tools/FileEdit.ts",
    "./tools/RunCommand": "./src/tools/RunCommand.ts",
    "./tools/WebSearch": "./src/tools/WebSearch.ts",
    "./tools/WebFetch": "./src/tools/WebFetch.ts",
    "./tools/Calculator": "./src/tools/Calculator.ts",
    "./tools/ListDir": "./src/tools/ListDir.ts",
    "./tools/CodeSearch": "./src/tools/CodeSearch.ts",
    "./tools/Now": "./src/tools/Now.ts",
    "./tools/StateStore": "./src/tools/StateStore.ts",
    "./tools/RAGSearch": "./src/tools/RAGSearch.ts",
    "./memories/rag": "./src/memories/rag.ts",
    "./memories/store": "./src/memories/store.ts",
    "./ragIntegration": "./src/ragIntegration.ts",
    "./semanticRouter": "./src/semanticRouter.ts",
    "./cachedRun": "./src/cachedRun.ts",
    "./ragDefaults": "./src/ragDefaults.ts"
  },
  "publish": {
    "exclude": ["examples/", "tests/"]
  },
  "tasks": {
    "dev": "deno run --watch examples/basic-chat.ts",
    "news": "deno run --allow-net --allow-read --allow-write --allow-env examples/news-digest.ts",
    "lint": "deno lint",
    "fmt": "deno fmt --check",
    "check": "deno lint && deno fmt --check",
    "test": "deno test --allow-ffi --allow-net --allow-read --allow-write --allow-env --allow-sys src/ tests/store.test.ts tests/chunker.test.ts tests/rag.test.ts",
    "test:int": "deno test --allow-net=localhost:11434 --allow-env --allow-run=deno tests/integration/"
  },
  "imports": {
    "ollama": "npm:ollama@^0.6.3",
    "@modelcontextprotocol/sdk/server": "npm:@modelcontextprotocol/sdk@^1.12.1/server",
    "@modelcontextprotocol/sdk/client": "npm:@modelcontextprotocol/sdk@^1.12.1/client",
    "zod": "npm:zod@^4",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "better-sqlite3-multiple-ciphers": "npm:better-sqlite3-multiple-ciphers@^13.0.3",
    "openai": "npm:openai@^7.15.0"
  },
  "nodeModulesDir": "auto"
}
